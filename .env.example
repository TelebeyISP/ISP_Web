# Telebey Web — copy to .env.local and adjust as needed
#   cp .env.example .env.local

# ApiGate NestJS gateway (https://github.com/TelebeyISP/ApiGate)
# Leave as /apigate to use the Vite dev proxy (see vite.config.ts).
# In production, set this to the public ApiGate origin, e.g. https://api.telebey.com
VITE_APIGATE_URL=/apigate

# Optional: override the proxy target when ApiGate is not on localhost:4000
# APIGATE_PROXY_TARGET=http://127.0.0.1:4000

# Medusa shop (catalog + cart). The Vite dev server proxies /medusa to this target.
# VITE_MEDUSA_URL=/medusa
# MEDUSA_PROXY_TARGET=http://127.0.0.1:9000
# Publishable key from the Medusa admin (Settings → Publishable API Keys).
# VITE_MEDUSA_PUBLISHABLE_KEY=pk_...
